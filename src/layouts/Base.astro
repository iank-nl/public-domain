---
import '@fontsource/young-serif/latin-400.css';
import '@fontsource-variable/instrument-sans/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { analyticsEnabled, site } from '../site.config';
import { dictionaries, href, type Lang } from '../i18n';
import { offers } from '../i18n/offers';

interface Props {
  lang: Lang;
  /** Language-neutral path such as /about/. Leave out for pages without a translation (404). */
  path?: string;
  title: string;
  description?: string;
  type?: 'website' | 'article';
  /** The homepage ends in bedrock, so its footer doesn't need the strata above it. */
  footerStrata?: boolean;
  noindex?: boolean;
  /** Extra schema.org objects describing this page. */
  schema?: Record<string, unknown>[];
}

const { lang, path, title, description, type = 'website', footerStrata = true, noindex = false, schema = [] } = Astro.props;
const t = dictionaries[lang];
const pageTitle = `${title} · ${site.name}`;
const desc = description ?? t.meta.description;
const canonical = new URL(path ? href(lang, path) : Astro.url.pathname, site.url).href;
const ogImage = new URL('/og.png', site.url).href;
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': `${site.url}/#business`,
      name: site.name,
      legalName: site.legalName,
      url: site.url,
      email: site.email,
      image: ogImage,
      description: dictionaries[lang].meta.description,
      address: {
        '@type': 'PostalAddress',
        addressCountry: 'NL',
        addressRegion: site.region,
      },
      areaServed: [
        { '@type': 'Country', name: 'Netherlands' },
        { '@type': 'Country', name: 'Belgium' },
        { '@type': 'Place', name: 'European Union' },
      ],
      identifier: { '@type': 'PropertyValue', propertyID: 'KVK', value: site.kvk },
      vatID: site.vatId,
      sameAs: [site.linkedin],
      founder: { '@id': `${site.url}/#owner` },
      knowsAbout: [
        'Laravel',
        'PHP',
        'Web application security',
        'Linux server management',
        'Amazon Web Services',
        'AWS cost optimisation',
        'Cyber security',
        'Artificial intelligence',
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: lang === 'nl' ? 'Vaste pakketten' : 'Fixed-scope offers',
        url: new URL(href(lang, '/work/offers/'), site.url).href,
        itemListElement: offers[lang].map((offer) => ({
          '@type': 'Offer',
          url: new URL(href(lang, `/work/offers/#${offer.slug}`), site.url).href,
          itemOffered: { '@type': 'Service', name: offer.name, description: offer.summary },
          priceSpecification: {
            '@type': offer.unit ? 'UnitPriceSpecification' : 'PriceSpecification',
            minPrice: offer.amount,
            priceCurrency: 'EUR',
            valueAddedTaxIncluded: false,
            ...(offer.unit === 'month' && { unitCode: 'MON', unitText: 'month' }),
          },
        })),
      },
    },
    {
      '@type': 'Person',
      '@id': `${site.url}/#owner`,
      name: site.owner,
      url: `${site.url}/about/`,
      jobTitle: 'Freelance Laravel developer and security engineer',
      knowsLanguage: ['nl', 'en'],
      sameAs: [site.linkedin],
      worksFor: { '@id': `${site.url}/#business` },
    },
    ...schema,
  ],
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {
      path && (
        <>
          <link rel="alternate" hreflang="en" href={new URL(path, site.url).href} />
          <link rel="alternate" hreflang="nl" href={new URL(href('nl', path), site.url).href} />
          <link rel="alternate" hreflang="x-default" href={new URL(path, site.url).href} />
        </>
      )
    }
    <link rel="alternate" type="application/rss+xml" title={site.name} href={href(lang, '/rss.xml')} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f8f3e8" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'nl' ? 'nl_NL' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={structuredData} />
    {
      analyticsEnabled && (
        <script
          is:inline
          defer
          src={site.analytics.src}
          data-website-id={site.analytics.websiteId}
          data-domains={new URL(site.url).hostname}
        />
      )
    }
    {
      path && lang === 'en' && (
        <script is:inline>
          // Dutch browsers get the Dutch site on arrival. A language picked in the footer always wins,
          // and navigation inside the site is left alone.
          (function () {
            try {
              var saved = localStorage.getItem('lang');
              var arriving = document.referrer.indexOf(location.origin) !== 0;
              if (saved === 'nl' || (!saved && arriving && /^nl\b/i.test(navigator.language))) {
                location.replace('/nl' + location.pathname + location.search + location.hash);
              }
            } catch (e) {}
          })();
        </script>
      )
    }
  </head>
  <body>
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} path={path} strata={footerStrata} />
  </body>
</html>
