---
import type { Lang } from '../i18n';
import { testimonialLabels, testimonials } from '../i18n/testimonials';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const list = testimonials[lang];
---

{
  list.length > 0 && (
    <section class="section testimonials">
      <div class="wrap">
        <span class="tag">{testimonialLabels[lang].tag}</span>
        <ul>
          {list.map((item) => (
            <li>
              <figure>
                <blockquote>{item.quote}</blockquote>
                <figcaption>{item.attribution}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  /* Extra room below, because on the homepage the strata edge overlaps this section. */
  .testimonials {
    padding-bottom: clamp(64px, 10vw, 140px);
  }

  ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  figure {
    margin: 0;
    padding-top: 1rem;
    border-top: 3px solid var(--accent);
  }

  blockquote {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(1.25rem, 1.9vw, 1.55rem);
    line-height: 1.3;
  }

  blockquote::before {
    content: '“';
  }

  blockquote::after {
    content: '”';
  }

  figcaption {
    margin-top: 1rem;
    font-size: 0.95rem;
    color: var(--ink-2);
  }
</style>
