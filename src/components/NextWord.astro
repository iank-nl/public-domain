---
import { dictionaries, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dictionaries[lang].widget;

const corpus = {
  en: 'the model reads the prompt . the model predicts the next word . the next word depends on the last word . the last word is all this model can see . a large model can see the whole prompt . a large model learns from text . this model learns from text too . the text is short . the prompt is short . the answer is a guess . the answer is a good guess when the text is long . a good guess is still a guess . the model never checks the answer . you should check the answer . good software checks the answer . good software reads the text , checks the numbers and writes the report . the report is short . the numbers come from the database . the model writes the words . the database keeps the numbers .',
  nl: 'het model leest de prompt . het model voorspelt het volgende woord . het volgende woord hangt af van het laatste woord . het laatste woord is alles wat dit model ziet . een groot model ziet de hele prompt . een groot model leert van tekst . dit model leert ook van tekst . de tekst is kort . de prompt is kort . het antwoord is een gok . het antwoord is een goede gok als de tekst lang is . een goede gok blijft een gok . het model controleert het antwoord nooit . jij moet het antwoord controleren . goede software controleert het antwoord . goede software leest de tekst , controleert de cijfers en schrijft het rapport . het rapport is kort . de cijfers komen uit de database . het model schrijft de woorden . de database bewaart de cijfers .',
};
---

<next-word class="nw" data-corpus={corpus[lang]} data-start={t.start} data-intro={t.intro}>
  <div class="nw-head">
    <span class="tag">{t.label}</span>
    <h3>{t.title}</h3>
    <p class="nw-intro">{t.intro.replace('{n}', String(corpus[lang].split(' ').length))}</p>
  </div>
  <p class="nw-sentence" aria-live="polite"></p>
  <div class="nw-label tag">{t.next}</div>
  <div class="nw-options"></div>
  <div class="nw-controls">
    <button type="button" class="nw-pick">{t.pick}</button>
    <button type="button" class="nw-reset">{t.reset}</button>
    <label class="nw-temp">
      <span class="tag">{t.temperature}</span>
      <span class="nw-scale">{t.cool}</span>
      <input type="range" min="0.25" max="2.5" step="0.05" value="1" />
      <span class="nw-scale">{t.hot}</span>
    </label>
  </div>
  <p class="nw-note">{t.note}</p>
</next-word>

<script>
  class NextWord extends HTMLElement {
    private counts = new Map<string, Map<string, number>>();
    private sentence: string[] = [];
    private start = '';
    private temperature = 1;

    connectedCallback() {
      const tokens = (this.dataset.corpus ?? '').split(' ');
      this.start = this.dataset.start ?? tokens[0];

      tokens.forEach((token, i) => {
        const next = tokens[i + 1];
        if (!next) return;
        const row = this.counts.get(token) ?? new Map<string, number>();
        row.set(next, (row.get(next) ?? 0) + 1);
        this.counts.set(token, row);
      });

      this.querySelector('.nw-pick')!.addEventListener('click', () => this.sample());
      this.querySelector('.nw-reset')!.addEventListener('click', () => this.reset());
      this.querySelector('input')!.addEventListener('input', (event) => {
        this.temperature = Number((event.target as HTMLInputElement).value);
        this.renderOptions();
      });
      this.reset();
    }

    /** The whole model: how often each word followed the last one, reshaped by temperature. */
    private probabilities() {
      const row = this.counts.get(this.sentence[this.sentence.length - 1]) ?? new Map<string, number>();
      const weighted = [...row].map(([word, count]) => [word, Math.pow(count, 1 / this.temperature)] as const);
      const total = weighted.reduce((sum, [, weight]) => sum + weight, 0);
      return weighted
        .map(([word, weight]) => ({ word, p: weight / total }))
        .sort((a, b) => b.p - a.p || a.word.localeCompare(b.word));
    }

    private sample() {
      let roll = Math.random();
      for (const { word, p } of this.probabilities()) {
        roll -= p;
        if (roll <= 0) return this.addWord(word);
      }
    }

    private addWord(word: string) {
      if (this.sentence.length >= 40) this.sentence = [];
      this.sentence.push(word);
      this.render();
    }

    private reset() {
      this.sentence = [this.start];
      this.render();
    }

    private render() {
      this.querySelector('.nw-sentence')!.textContent = this.sentence.join(' ').replace(/ ([.,])/g, '$1');
      this.renderOptions();
    }

    private renderOptions() {
      const list = this.querySelector('.nw-options')!;
      list.replaceChildren(
        ...this.probabilities()
          .slice(0, 6)
          .map(({ word, p }) => {
            const option = document.createElement('button');
            option.type = 'button';
            option.className = 'nw-option';
            option.style.setProperty('--p', String(p));

            const label = document.createElement('span');
            label.textContent = word;
            const value = document.createElement('span');
            value.textContent = `${Math.round(p * 100)}%`;

            option.append(label, value);
            option.addEventListener('click', () => this.addWord(word));
            return option;
          }),
      );
    }
  }

  customElements.define('next-word', NextWord);
</script>

<style is:global>
  .nw {
    display: block;
    padding: clamp(18px, 3vw, 32px);
    border: 1px solid color-mix(in srgb, currentColor 30%, transparent);
    background: color-mix(in srgb, currentColor 5%, transparent);
  }

  .nw h3 {
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    margin-block: 0.35em;
  }

  .nw p.nw-intro,
  .nw p.nw-note {
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
  }

  .nw .nw-sentence {
    font-family: var(--display);
    font-size: clamp(1.3rem, 2.6vw, 1.9rem);
    line-height: 1.3;
    min-height: 2.6em;
    margin: 1.1rem 0;
  }

  .nw .nw-sentence::after {
    content: '';
    display: inline-block;
    width: 0.5em;
    height: 0.12em;
    margin-left: 0.2em;
    background: currentColor;
    animation: nw-blink 1.1s steps(2) infinite;
  }

  @keyframes nw-blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nw .nw-sentence::after {
      animation: none;
    }
  }

  .nw-options {
    display: grid;
    gap: 4px;
    margin-top: 0.5rem;
    min-height: 13.2rem;
    align-content: start;
  }

  .nw-option {
    position: relative;
    display: flex;
    justify-content: space-between;
    width: 100%;
    padding: 0.35rem 0.6rem;
    font: 500 0.95rem var(--mono);
    color: inherit;
    text-align: left;
    background: linear-gradient(
      to right,
      color-mix(in srgb, currentColor 26%, transparent) calc(var(--p) * 100%),
      color-mix(in srgb, currentColor 6%, transparent) calc(var(--p) * 100%)
    );
    border: 0;
    cursor: pointer;
  }

  .nw-option:hover {
    outline: 1px solid currentColor;
  }

  .nw-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-block: 1rem;
  }

  .nw-pick,
  .nw-reset {
    padding: 0.55em 1em;
    font: 600 0.95rem var(--body);
    color: inherit;
    background: transparent;
    border: 1px solid currentColor;
    cursor: pointer;
  }

  .nw-pick {
    background: var(--magma);
    color: var(--magma-ink);
    border-color: var(--magma);
  }

  .nw-temp {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .nw-temp input {
    accent-color: var(--magma);
    width: 7rem;
  }

  .nw-scale {
    font-size: 0.85rem;
  }
</style>
