---
import { site } from '../site.config';
import { dictionaries, href, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  heading?: string;
  body?: string;
  /** Set on case studies, so clicks in this block also count as a case-study-cta event for that case. */
  caseSlug?: string;
}

const { lang, heading, body, caseSlug } = Astro.props;
const t = dictionaries[lang];
---

<section class="section">
  <div class="wrap ask" data-case={caseSlug}>
    <h2>{heading ?? t.work.cta}</h2>
    <p>{body ?? t.work.ctaBody}</p>
    <slot />
    <div class="actions">
      <a class="btn" href={site.bookingUrl} data-umami-event="book-call" data-umami-event-position="cta" data-cta="book">
        {t.contact.book}
      </a>
      <a class="link arrow" href={href(lang, '/contact/#intake')} data-cta="intake">{t.contact.intake}</a>
    </div>
    <p class="available">{t.availability}</p>
    <p class="mail">{t.contact.orEmail} <a class="link" href={`mailto:${site.email}`} data-umami-event="email-click" data-umami-event-position="cta">{site.email}</a></p>
  </div>
</section>

<script>
  // The booking button already sends book-call through its data attributes. On case studies both
  // buttons also send case-study-cta, which an element can't carry as a second attribute.
  document.querySelectorAll<HTMLElement>('[data-case]').forEach((block) => {
    block.querySelectorAll<HTMLAnchorElement>('[data-cta]').forEach((link) => {
      link.addEventListener('click', () => {
        window.umami?.track('case-study-cta', { case: block.dataset.case ?? '', target: link.dataset.cta ?? '' });
      });
    });
  });
</script>

<style>
  .ask h2 {
    font-size: clamp(2rem, 4.5vw, 3.4rem);
    margin-bottom: 0.4em;
  }

  /* :global so paragraphs passed in through the slot get the same measure. */
  .ask > :global(p) {
    max-width: 38em;
  }

  .ask > :global(p + p) {
    margin-top: 0.75rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 1.5rem;
  }

  .available {
    margin-top: 1.5rem;
    display: inline-flex;
    align-items: baseline;
    gap: 0.55em;
  }

  .available::before {
    content: '';
    flex: none;
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: var(--accent);
    transform: translateY(-0.05em);
  }

  .mail {
    margin-top: 1.25rem;
    color: var(--ink-2);
    font-size: 0.97rem;
  }
</style>
