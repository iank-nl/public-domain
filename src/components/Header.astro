---
import Mark from './Mark.astro';
import { site } from '../site.config';
import { dictionaries, href, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dictionaries[lang].nav;
---

<header class="wrap bar">
  <a class="brand" href={href(lang, '/')}>
    <Mark />
    <span>{site.name}</span>
  </a>
  <nav aria-label={t.menu}>
    <a href={href(lang, '/work/')}>{t.work}</a>
    <a href={href(lang, '/about/')}>{t.about}</a>
    <a href={href(lang, '/knowledge/')}>{t.knowledge}</a>
  </nav>
</header>

<style>
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 1.25rem;
    position: relative;
    z-index: 2;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--display);
    font-size: 1.35rem;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: clamp(0.9rem, 3vw, 2.25rem);
  }

  nav a {
    text-decoration: none;
    font-weight: 500;
    font-size: 1rem;
  }

  nav a:hover {
    color: var(--accent);
  }
</style>
