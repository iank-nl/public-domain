---
import Mark from './Mark.astro';
import { site } from '../site.config';
import { dictionaries, href, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dictionaries[lang].nav;
const c = dictionaries[lang].contact;
---

<header class="wrap bar">
  <a class="brand" href={href(lang, '/')}>
    <Mark />
    <span>{site.name}</span>
  </a>
  <nav aria-label={t.menu}>
    <a href={href(lang, '/work/')}>{t.work}</a>
    <a href={href(lang, '/about/')}>{t.about}</a>
    <a href={href(lang, '/knowledge/')}>{t.knowledge}</a>
    <a class="btn book" href={site.bookingUrl} data-umami-event="book-call" data-umami-event-position="header">{c.bookShort}</a>
  </nav>
</header>

<style>
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 1.25rem;
    position: relative;
    z-index: 2;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--display);
    font-size: 1.35rem;
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 0.5rem clamp(0.9rem, 3vw, 2.25rem);
  }

  nav a {
    text-decoration: none;
    font-weight: 500;
    font-size: 1rem;
  }

  nav a:not(.btn):hover {
    color: var(--accent);
  }

  nav .book {
    padding: 0.6em 1em;
    font-size: 0.95rem;
  }

  @media (max-width: 560px) {
    .bar {
      flex-wrap: wrap;
    }

    nav {
      width: 100%;
      justify-content: flex-start;
    }

    nav .book {
      margin-left: auto;
    }
  }
</style>
