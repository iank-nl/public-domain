---
import Base from '../../../layouts/Base.astro';
import Phone from '../../../components/Phone.astro';
import { screenshots } from '../../../lib/screenshots';
import { dictionaries, href, localePaths, type Lang } from '../../../i18n';

export function getStaticPaths() {
  return localePaths();
}

const lang = Astro.props.lang as Lang;
const t = dictionaries[lang];
const r = t.relic;
const shots = screenshots(lang);
const gallery = [
  { src: shots.board, alt: r.shots.board },
  { src: shots.reveal, alt: r.shots.reveal },
  { src: shots.museum, alt: r.shots.museum },
  { src: shots.map, alt: r.shots.map },
  { src: shots.big, alt: r.shots.big },
];
---

<Base lang={lang} path="/work/relic-sweeper/" title={r.title} description={r.lede}>
  <section class="wrap page-head">
    <a class="tag back" href={href(lang, '/work/')}>← {t.work.title}</a>
    <h1>{r.heading}</h1>
    <p class="lede">{r.lede}</p>
    <dl class="facts">
      {r.facts.map((fact) => <div><dt class="tag">{fact.label}</dt><dd>{fact.value}</dd></div>)}
    </dl>
  </section>

  <section class="stratum tone-1 numbers">
    <div class="wrap">
      <dl class="stats">
        {r.stats.map((stat) => <div><dt>{stat.label}</dt><dd>{stat.value}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="section game">
    <div class="wrap">
      <span class="tag">{r.gameLabel}</span>
      <p class="lede">{r.gameBody}</p>
    </div>
    <div class="gallery" tabindex="0" role="group" aria-label={r.gameLabel}>
      {gallery.map((shot) => <Phone src={shot.src} alt={shot.alt} />)}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="tag">{r.hardLabel}</span>
      <div class="hard">
        {r.hard.map((item) => <article><h2>{item.title}</h2><p>{item.body}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="tag">{r.processLabel}</span>
      <p class="lede">{r.processBody}</p>
      <p class="after">
        <a class="link arrow" href={href(lang, '/knowledge/shipping-a-game-with-agents/')}>{r.processLink}</a>
      </p>
      <p class="after small"><a class="link" href="/apps/privacy-policy/relic-sweeper.txt">{r.privacy}</a></p>
    </div>
  </section>
</Base>

<style>
  .back {
    text-decoration: none;
    color: var(--ink-2);
  }

  .page-head h1 {
    max-width: 19ch;
    font-size: clamp(2.4rem, 6vw, 5rem);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem clamp(1.5rem, 4vw, 3.5rem);
    margin: 2rem 0 0;
  }

  .facts dt {
    color: var(--ink-2);
  }

  .facts dd {
    margin: 0;
    font-weight: 600;
  }

  .numbers {
    padding-block: clamp(32px, 5vw, 64px);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 0;
  }

  .stats div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
  }

  .stats dd {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(2.4rem, 6vw, 5rem);
    line-height: 1;
  }

  .stats dt {
    font-size: 0.95rem;
    margin-top: 0.4rem;
  }

  .game {
    border-top: 0;
  }

  .game .tag {
    margin-bottom: 1rem;
  }

  .gallery {
    display: flex;
    gap: clamp(12px, 2vw, 24px);
    overflow-x: auto;
    padding: 2.5rem var(--gutter) 3.5rem;
    margin-top: 0.5rem;
    scroll-snap-type: x proximity;
  }

  .gallery :global(.phone) {
    flex: 0 0 min(62vw, 270px);
    scroll-snap-align: center;
  }

  .hard {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3.5rem) clamp(2rem, 6vw, 6rem);
  }

  .hard h2 {
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    margin-bottom: 0.5em;
  }

  .after {
    margin-top: 1.25rem;
  }

  .small {
    font-size: 0.95rem;
  }

  @media (max-width: 860px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hard {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
