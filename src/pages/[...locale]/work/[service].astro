---
import Base from '../../../layouts/Base.astro';
import { site } from '../../../site.config';
import { dictionaries, href, type Lang } from '../../../i18n';
import { serviceLabels, servicePages } from '../../../i18n/services';

export function getStaticPaths() {
  return (['en', 'nl'] as Lang[]).flatMap((lang) =>
    servicePages[lang].map((page) => ({
      params: { locale: lang === 'en' ? undefined : lang, service: page.slug },
      props: { lang, page },
    })),
  );
}

type Page = (typeof servicePages)['en'][number];
const { lang, page } = Astro.props as { lang: Lang; page: Page };
const t = dictionaries[lang];
const labels = serviceLabels[lang];
const projects = t.work.selected[page.group].items;
const path = `/work/${page.slug}/`;

const schema = {
  '@type': 'Service',
  name: page.name,
  description: page.description,
  url: new URL(href(lang, path), site.url).href,
  serviceType: page.name,
  areaServed: { '@type': 'Country', name: 'Netherlands' },
  provider: { '@id': `${site.url}/#business` },
};
---

<Base lang={lang} path={path} title={page.seoTitle} description={page.description} schema={[schema]}>
  <section class="wrap page-head">
    <a class="tag back" href={href(lang, '/work/')}>← {labels.back}</a>
    <span class:list={['tag', 'chip', page.tone]}>{page.name}</span>
    <h1>{page.heading}</h1>
    <p class="lede">{page.lede}</p>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="tag">{labels.help}</span>
      <div class="help">
        {page.help.map((item) => <article><h2>{item.title}</h2><p>{item.body}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap columns">
      <div>
        <span class="tag section-tag">{labels.signs}</span>
        <ul class="signs">{page.signs.map((sign) => <li>{sign}</li>)}</ul>
      </div>
      <div>
        <span class="tag section-tag">{labels.past}</span>
        <ul class="past">
          {projects.map((project) => <li><h3>{project.title}</h3><p>{project.body}</p></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap ask">
      <h2>{t.work.cta}</h2>
      <p>{t.work.ctaBody}</p>
      <a class="btn" href={`mailto:${site.email}`}>{t.nav.contact}</a>
    </div>
  </section>
</Base>

<style>
  .back {
    display: block;
    text-decoration: none;
    color: var(--ink-2);
    margin-bottom: 2rem;
  }

  .chip {
    display: inline-block;
    padding: 0.3em 0.7em;
    background: var(--band);
    color: var(--band-ink);
  }

  .page-head h1 {
    max-width: 18ch;
    font-size: clamp(2.4rem, 6vw, 5rem);
  }

  .help {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.75rem, 3.5vw, 3rem) clamp(2rem, 6vw, 6rem);
  }

  .help h2 {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    margin-bottom: 0.4em;
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 6vw, 6rem);
  }

  .signs,
  .past {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .signs li,
  .past li {
    padding-block: 0.8rem;
    border-top: 1px solid var(--line);
  }

  .signs li {
    font-size: 1.15rem;
    line-height: 1.4;
  }

  .past h3 {
    font-family: var(--body);
    font-size: 1.05rem;
    font-weight: 650;
    letter-spacing: 0;
    margin-bottom: 0.2em;
  }

  .past p {
    font-size: 0.97rem;
    color: var(--ink-2);
  }

  .ask h2 {
    font-size: clamp(2rem, 4.5vw, 3.4rem);
    margin-bottom: 0.4em;
  }

  .ask .btn {
    margin-top: 1.5rem;
  }

  @media (max-width: 760px) {
    .help,
    .columns {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
