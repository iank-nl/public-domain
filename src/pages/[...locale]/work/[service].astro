---
import Base from '../../../layouts/Base.astro';
import ContactCta from '../../../components/ContactCta.astro';
import { site } from '../../../site.config';
import { dictionaries, getArticles, href, slugOf, type Lang } from '../../../i18n';
import { serviceLabels, servicePages, type ServicePage } from '../../../i18n/services';
import { offerBySlug, offerLabels } from '../../../i18n/offers';
import { caseLabels } from '../../../i18n/cases';

export function getStaticPaths() {
  return (['en', 'nl'] as Lang[]).flatMap((lang) =>
    servicePages[lang].map((page) => ({
      params: { locale: lang === 'en' ? undefined : lang, service: page.slug },
      props: { lang, page },
    })),
  );
}

const { lang, page } = Astro.props as { lang: Lang; page: ServicePage };
const t = dictionaries[lang];
const labels = serviceLabels[lang];
const projects = page.group === undefined ? [] : t.work.selected[page.group].items;
// Pages without client projects (AI) show the AI articles and the Relic Sweeper case as proof.
const proof =
  page.group === undefined ? (await getArticles(lang)).filter((article) => article.data.track !== 'software') : [];
const path = `/work/${page.slug}/`;
const offerText = offerLabels[lang];
const related = page.offers.map((slug) => offerBySlug(lang, slug));

const schema = {
  '@type': 'Service',
  name: page.name,
  description: page.description,
  url: new URL(href(lang, path), site.url).href,
  serviceType: page.name,
  areaServed: { '@type': 'Country', name: 'Netherlands' },
  provider: { '@id': `${site.url}/#business` },
};
---

<Base lang={lang} path={path} title={page.seoTitle} description={page.description} schema={[schema]}>
  <section class="wrap page-head">
    <a class="tag back" href={href(lang, '/work/')}>← {labels.back}</a>
    <span class:list={['tag', 'chip', page.tone]}>{page.name}</span>
    <h1>{page.heading}</h1>
    <p class="lede">{page.lede}</p>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="tag">{labels.help}</span>
      <div class="help">
        {page.help.map((item) => <article><h2>{item.title}</h2><p>{item.body}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap columns">
      <div>
        <span class="tag section-tag">{labels.signs}</span>
        <ul class="signs">{page.signs.map((sign) => <li>{sign}</li>)}</ul>
      </div>
      {
        page.group === undefined ? (
          <div>
            <span class="tag section-tag">{labels.proof}</span>
            <ul class="past">
              <li>
                <h3><a class="link arrow" href={href(lang, '/work/relic-sweeper/')}>{t.relic.heading}</a></h3>
                <p>{t.layers.finds.appsBody}</p>
              </li>
              {proof.map((article) => (
                <li>
                  <h3><a class="link arrow" href={href(lang, `/knowledge/${slugOf(article)}/`)}>{article.data.title}</a></h3>
                  <p>{article.data.description}</p>
                </li>
              ))}
            </ul>
          </div>
        ) : (
          <div>
            <span class="tag section-tag">{labels.past}</span>
            <ul class="past">
              {projects.map((project) => (
                <li>
                  <h3>{project.title}</h3>
                  <p>{project.body}</p>
                  {'case' in project && project.case && (
                    <a class="link arrow case" href={href(lang, `/work/cases/${project.case}/`)}>{caseLabels[lang].read}</a>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="tag">{offerText.related}</span>
      <ul class="offers">
        {
          related.map((offer) => (
            <li class={offer.tone}>
              <a href={href(lang, `/work/offers/#${offer.slug}`)}>
                <h3>{offer.name}</h3>
                <p>{offer.summary}</p>
              </a>
            </li>
          ))
        }
      </ul>
      <a class="link arrow more" href={href(lang, '/work/offers/')}>{offerText.all}</a>
    </div>
  </section>

  <ContactCta lang={lang} />
</Base>

<style>
  .back {
    display: block;
    text-decoration: none;
    color: var(--ink-2);
    margin-bottom: 2rem;
  }

  .chip {
    display: inline-block;
    padding: 0.3em 0.7em;
    background: var(--band);
    color: var(--band-ink);
  }

  .page-head h1 {
    max-width: 18ch;
    font-size: clamp(2.4rem, 6vw, 5rem);
  }

  .help {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.75rem, 3.5vw, 3rem) clamp(2rem, 6vw, 6rem);
  }

  .help h2 {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    margin-bottom: 0.4em;
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 6vw, 6rem);
  }

  .signs,
  .past {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .signs li,
  .past li {
    padding-block: 0.8rem;
    border-top: 1px solid var(--line);
  }

  .signs li {
    font-size: 1.15rem;
    line-height: 1.4;
  }

  .past h3 {
    font-family: var(--body);
    font-size: 1.05rem;
    font-weight: 650;
    letter-spacing: 0;
    margin-bottom: 0.2em;
  }

  .past .case {
    display: inline-block;
    margin-top: 0.4rem;
    font-size: 0.95rem;
  }

  .past p {
    font-size: 0.97rem;
    color: var(--ink-2);
  }

  .offers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .offers a {
    display: block;
    height: 100%;
    padding: clamp(20px, 3vw, 36px);
    background-color: var(--band);
    background-image: var(--litho);
    color: var(--band-ink);
    text-decoration: none;
  }

  .offers h3 {
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    margin-bottom: 0.4em;
  }

  .offers a:hover h3 {
    text-decoration: underline;
  }

  .more {
    display: inline-block;
    margin-top: 1.25rem;
  }

  @media (max-width: 760px) {
    .help,
    .columns,
    .offers {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
