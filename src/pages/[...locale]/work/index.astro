---
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import ContactCta from '../../../components/ContactCta.astro';
import icon from '../../../assets/relic-sweeper/icon.png';
import { dictionaries, href, localePaths, type Lang } from '../../../i18n';
import { servicePages } from '../../../i18n/services';
import { offerLabels, offers } from '../../../i18n/offers';
import { caseLabels, cases } from '../../../i18n/cases';

export function getStaticPaths() {
  return localePaths();
}

const lang = Astro.props.lang as Lang;
const t = dictionaries[lang];
const offerText = offerLabels[lang];
const caseText = caseLabels[lang];
---

<Base lang={lang} path="/work/" title={t.work.seoTitle}>
  <section class="wrap page-head">
    <span class="tag">{t.work.title}</span>
    <h1>{t.work.heading}</h1>
    <p class="lede">{t.work.lede}</p>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="tag">{t.work.servicesLabel}</span>
      <div class="services">
        {
          t.work.services.map((service, i) => (
            <article class={`tone-${i + 1}`}>
              <h2>{service.title}</h2>
              <div>
                <p>{service.body}</p>
                {servicePages[lang][i] && (
                  <a class="link arrow more" href={href(lang, `/work/${servicePages[lang][i].slug}/`)}>{t.layers.more}</a>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="offers">
    <div class="wrap teaser">
      <div>
        <span class="tag section-tag">{offerText.tag}</span>
        <h2>{offerText.teaser}</h2>
        <p>{offerText.teaserBody}</p>
        <a class="btn" href={href(lang, '/work/offers/')}>{offerText.all}</a>
      </div>
      <ul>
        {
          offers[lang].map((offer) => (
            <li>
              <a class="link arrow" href={href(lang, `/work/offers/#${offer.slug}`)}>{offer.name}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" id="selected">
    <div class="wrap">
      <span class="tag">{t.work.selectedLabel}</span>
      <div class="selected">
        {
          t.work.selected.map((group) => (
            <div>
              <h2>{group.title}</h2>
              <ul>
                {group.items.map((item) => (
                  <li>
                    <h3>{item.title}</h3>
                    <p>{item.body}</p>
                    {'case' in item && item.case && (
                      <a class="link arrow" href={href(lang, `/work/cases/${item.case}/`)}>{caseText.read}</a>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="cases">
    <div class="wrap">
      <span class="tag">{caseText.list}</span>
      <ul class="cases">
        {
          cases[lang].map((study) => (
            <li class={study.tone}>
              <a href={href(lang, `/work/cases/${study.slug}/`)}>
                <span class="tag">{study.title}</span>
                <h2>{study.heading}</h2>
                <span class="link arrow">{caseText.read}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="tag">{t.work.processLabel}</span>
      <ol class="process">
        {t.work.process.map((step) => <li><h3>{step.title}</h3><p>{step.body}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="tag">{t.work.caseLabel}</span>
      <a class="case" href={href(lang, '/work/relic-sweeper/')}>
        <Image src={icon} alt="" width={120} height={120} format="webp" />
        <div>
          <h2>{t.relic.heading}</h2>
          <p>{t.relic.lede}</p>
        </div>
      </a>
    </div>
  </section>

  <ContactCta lang={lang} />
</Base>

<style>
  .services {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
  }

  .services article {
    background-color: var(--band);
    background-image: var(--litho);
    color: var(--band-ink);
    padding: clamp(24px, 3.4vw, 44px);
    min-height: 17rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2.5rem;
  }

  .services h2 {
    font-size: clamp(1.8rem, 3.2vw, 2.7rem);
    max-width: 12ch;
  }

  .services p {
    max-width: 34em;
  }

  .more {
    display: inline-block;
    margin-top: 0.9rem;
  }

  .teaser {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem clamp(2rem, 6vw, 6rem);
  }

  .teaser h2 {
    font-size: clamp(1.8rem, 3.4vw, 2.8rem);
    margin-bottom: 0.4em;
  }

  .teaser .btn {
    margin-top: 1.5rem;
  }

  .teaser ul {
    list-style: none;
    margin: 0;
    padding: 0;
    align-self: end;
  }

  .teaser li {
    padding-block: 0.7rem;
    border-top: 1px solid var(--line);
  }

  .selected {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .selected h2 {
    font-size: clamp(1.7rem, 2.8vw, 2.3rem);
  }

  .selected ul {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  .selected li {
    padding-block: 0.9rem;
    border-top: 1px solid var(--line);
  }

  .selected h3 {
    font-family: var(--body);
    font-size: 1.05rem;
    font-weight: 650;
    letter-spacing: 0;
    margin-bottom: 0.2em;
  }

  .selected li .link {
    display: inline-block;
    margin-top: 0.4rem;
    font-size: 0.95rem;
  }

  .selected p {
    font-size: 0.97rem;
    color: var(--ink-2);
  }

  .cases {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cases a {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
    padding: clamp(24px, 3.4vw, 44px);
    background-color: var(--band);
    background-image: var(--litho);
    color: var(--band-ink);
    text-decoration: none;
  }

  .cases h2 {
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    flex: 1;
  }

  .cases a:hover .link {
    text-decoration-thickness: 2px;
  }

  .process {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: step;
  }

  .process li {
    counter-increment: step;
  }

  .process li::before {
    content: '0' counter(step);
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--accent);
  }

  .process h3 {
    font-size: 1.6rem;
    margin-block: 0.3em;
  }

  .case {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: center;
    text-decoration: none;
  }

  .case img {
    border-radius: 24px;
  }

  .case h2 {
    font-size: clamp(1.7rem, 3.4vw, 2.8rem);
    margin-bottom: 0.4em;
  }

  .case:hover h2 {
    color: var(--accent);
  }

  @media (max-width: 860px) {
    .services,
    .teaser,
    .cases,
    .selected {
      grid-template-columns: minmax(0, 1fr);
    }

    .services article {
      min-height: 0;
    }

    .process {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .process {
      grid-template-columns: minmax(0, 1fr);
    }

    .case {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
