---
import Base from '../../layouts/Base.astro';
import { analyticsEnabled, site } from '../../site.config';
import { dictionaries, localePaths, type Lang } from '../../i18n';
import { offers } from '../../i18n/offers';

export function getStaticPaths() {
  return localePaths();
}

const lang = Astro.props.lang as Lang;
const t = dictionaries[lang];
const c = t.contact;
const errorStates = ['error', 'invalid', 'verification', 'rateLimited', 'expired'] as const;

if (site.intake.endpoint.startsWith('[TODO') || site.intake.turnstileSiteKey.startsWith('[TODO')) {
  console.warn('[contact] site.intake is not configured yet, so the intake form cannot send. See workers/intake/README.md.');
}
---

<Base lang={lang} path="/contact/" title={c.seoTitle} description={c.description}>
  <section class="wrap page-head">
    <span class="tag">{c.title}</span>
    <h1>{c.heading}</h1>
    <p class="lede">{c.lede}</p>
    <div class="actions">
      <a class="btn" href={site.bookingUrl} data-umami-event="book-call" data-umami-event-position="contact">{c.book}</a>
      <a class="link arrow" href="#intake">{c.intake}</a>
    </div>
    <p class="note available">{t.availability}</p>
    <p class="note">{c.reply}</p>
  </section>

  <section class="section" id="intake">
    <div class="wrap columns">
      <div>
        <span class="tag section-tag">{c.formLabel}</span>
        <h2>{c.intake}</h2>
        <p class="note">{c.formNote}</p>
        <p class="note">{c.orEmail} <a class="link" href={`mailto:${site.email}`} data-umami-event="email-click" data-umami-event-position="contact">{site.email}</a></p>
      </div>

      <form class="intake" data-endpoint={site.intake.endpoint} data-sending={c.sending}>
        <input type="hidden" name="lang" value={lang} />
        <input type="hidden" name="t" />
        <label>
          <span>{c.fields.name}</span>
          <input name="name" autocomplete="name" maxlength="100" required />
        </label>
        <label>
          <span>{c.fields.email}</span>
          <input name="email" type="email" autocomplete="email" maxlength="200" required />
        </label>
        <label>
          <span>{c.fields.company}</span>
          <input name="company" autocomplete="organization" maxlength="200" />
        </label>
        <label>
          <span>{c.fields.need}</span>
          <select name="need" required>
            {offers[lang].map((offer) => <option value={offer.slug}>{offer.name}</option>)}
            <option value="other" selected>{c.fields.needOther}</option>
          </select>
        </label>
        <label>
          <span>{c.fields.details}</span>
          <textarea name="details" rows="5" maxlength="4000" required></textarea>
        </label>
        <label>
          <span>{c.fields.stack}</span>
          <input name="stack" maxlength="200" />
        </label>
        <div class="pair">
          <label>
            <span>{c.fields.timeline}</span>
            <select name="timeline">
              <option value="">{c.choose}</option>
              {c.timelines.map((option) => <option value={option.value}>{option.label}</option>)}
            </select>
          </label>
          <label>
            <span>{c.fields.budget}</span>
            <select name="budget">
              <option value="">{c.choose}</option>
              {c.budgets.map((option) => <option value={option.value}>{option.label}</option>)}
            </select>
          </label>
        </div>

        <!-- Honeypot: off-screen and hidden from assistive tech. Only bots fill it in. -->
        <div class="hp" aria-hidden="true">
          <label>
            <span>{c.fields.honeypot}</span>
            <input name="referral_code" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <div
          class="cf-turnstile"
          data-sitekey={site.intake.turnstileSiteKey}
          data-language={lang}
          data-theme="light"
          data-size="flexible"
        >
        </div>
        <p class="privacy">{c.privacy}{analyticsEnabled && ` ${c.analytics}`}</p>
        <!-- The script enables this. Without JavaScript there is no spam check, so the form can't be sent. -->
        <button class="btn" type="submit" disabled>{c.submit}</button>
        <noscript>
          <p class="message">{c.noscript} {c.orEmail} <a class="link" href={`mailto:${site.email}`} data-umami-event="email-click" data-umami-event-position="intake">{site.email}</a>.</p>
        </noscript>
        <div class="status" aria-live="polite">
          <p class="message" data-status="success" hidden>{c.status.success}</p>
          {
            errorStates.map((state) => (
              <p class="message" data-status={state} hidden>
                {c.status[state]} {c.orEmail} <a class="link" href={`mailto:${site.email}`} data-umami-event="email-click" data-umami-event-position="intake">{site.email}</a>.
              </p>
            ))
          }
        </div>
      </form>
    </div>
  </section>
</Base>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  declare global {
    interface Window {
      turnstile?: { reset: () => void };
    }
  }

  // Only choices from fixed lists are sent along, never what someone typed.
  const track = (event: string, data: Record<string, string>) => window.umami?.track(event, data);

  // The Worker silently drops submissions made within 3 seconds of issuing the timestamp.
  const MIN_WAIT_MS = 3500;
  const ERRORS: Record<string, string> = {
    verification: 'verification',
    invalid: 'invalid',
    rate_limited: 'rateLimited',
    expired: 'expired',
  };

  const form = document.querySelector<HTMLFormElement>('form.intake');

  if (form) {
    const endpoint = (form.dataset.endpoint ?? '').replace(/\/$/, '');
    const need = form.elements.namedItem('need') as HTMLSelectElement;
    const stamp = form.elements.namedItem('t') as HTMLInputElement;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const label = button.textContent;
    const messages = form.querySelectorAll<HTMLElement>('[data-status]');
    let stampedAt = 0;

    // Offer pages link here with ?offer=<slug>, so the right option is already picked.
    const requested = new URLSearchParams(location.search).get('offer');
    if (requested && [...need.options].some((option) => option.value === requested)) need.value = requested;

    const show = (state: string | null) =>
      messages.forEach((message) => (message.hidden = message.dataset.status !== state));

    const fetchStamp = async () => {
      try {
        const response = await fetch(`${endpoint}/token`);
        if (!response.ok) return;
        stamp.value = (await response.json()).token;
        stampedAt = Date.now();
      } catch {
        // Worker unreachable. The submit fails as well and shows the email fallback.
      }
    };

    fetchStamp();
    button.disabled = false;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      show(null);
      button.disabled = true;
      button.textContent = form.dataset.sending ?? label;

      let state = 'error';
      const choices = {
        offer: need.value,
        budget: (form.elements.namedItem('budget') as HTMLSelectElement).value || 'none',
        timeline: (form.elements.namedItem('timeline') as HTMLSelectElement).value || 'none',
      };
      try {
        if (!stamp.value) await fetchStamp();
        const wait = MIN_WAIT_MS - (Date.now() - stampedAt);
        if (wait > 0) await new Promise((resolve) => setTimeout(resolve, wait));

        const data = new FormData(form);
        if (!data.get('cf-turnstile-response')) {
          state = 'verification';
        } else {
          const response = await fetch(endpoint, { method: 'POST', body: data });
          const result = await response.json().catch(() => ({}));
          state = response.ok && result.ok ? 'success' : (ERRORS[result.error] ?? 'error');
        }
      } catch {
        // Network error: keep the generic error, which includes the email fallback.
      }

      if (state === 'success') track('intake-submit', choices);
      else track('intake-error', { reason: state });

      // Turnstile tokens are single-use, and a fresh timestamp keeps the next attempt valid.
      window.turnstile?.reset();
      if (state === 'success') form.reset();
      if (state === 'success' || state === 'expired') await fetchStamp();
      button.disabled = false;
      button.textContent = label;
      show(state);
    });
  }
</script>

<style>
  .page-head h1 {
    max-width: 16ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2rem;
  }

  .note {
    margin-top: 1rem;
    color: var(--ink-2);
    max-width: 32em;
  }

  .available {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55em;
  }

  .available::before {
    content: '';
    flex: none;
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: var(--accent);
    transform: translateY(-0.05em);
  }

  .columns {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: 2rem clamp(2rem, 6vw, 6rem);
  }

  .columns h2 {
    font-size: clamp(1.9rem, 3.6vw, 3rem);
  }

  .intake {
    position: relative;
    display: grid;
    gap: 1.1rem;
  }

  .intake label {
    display: grid;
    gap: 0.35rem;
  }

  .intake label > span {
    font-weight: 600;
    font-size: 0.97rem;
  }

  .intake input,
  .intake select,
  .intake textarea {
    font: inherit;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid color-mix(in srgb, var(--ink) 40%, transparent);
    border-radius: 0;
    padding: 0.65em 0.75em;
    width: 100%;
  }

  .intake textarea {
    resize: vertical;
  }

  .intake :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem;
  }

  /* Off-screen rather than display:none, so bots that skip hidden fields still fill it in. */
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .privacy {
    color: var(--ink-2);
    font-size: 0.9rem;
    max-width: 36em;
  }

  .intake .btn {
    justify-self: start;
    border: 0;
    cursor: pointer;
    font: inherit;
    font-weight: 600;
  }

  .intake .btn:disabled {
    cursor: default;
    opacity: 0.6;
  }

  .message {
    max-width: 36em;
    padding: 0.75em 1em;
    border-left: 3px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, var(--paper));
  }

  .message[hidden] {
    display: none;
  }

  @media (max-width: 760px) {
    .columns,
    .pair {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
